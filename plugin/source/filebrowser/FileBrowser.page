require_once '/usr/local/emhttp/plugins/filebrowser/include/settings.php';

$fb_cfg     = fb_settings();
$fb_theme   = fb_theme($display);
$fb_running = fb_socket_present();
$fb_csrf    = _var($var, 'csrf_token');
$fb_started = (_var($var, 'fsState') == 'Started');
$fb_app     = '/plugins/filebrowser/app/index.html';

// The SPA is a static bundle served by emhttp's nginx, so it cannot read the
// webGUI's csrf_token itself. Hand it over on the iframe URL (same origin) so
// its POSTs through proxy.php can set the X-CSRF-TOKEN header. See
// plugin/README.md - "SPA contract".
// Installed plugin version, written into the package by the Makefile. Appended
// to the iframe URL purely as a cache-buster: the SPA's index.html lives at a
// fixed URL, and without this a browser keeps serving its cached copy (and the
// old hashed bundle it references) after a plugin update.
$fb_ver = @file_get_contents('/usr/local/emhttp/plugins/filebrowser/VERSION');
$fb_ver = preg_replace('/[^A-Za-z0-9.]/', '', (string)$fb_ver);
if ($fb_ver === '') $fb_ver = (string)@filemtime('/usr/local/emhttp/plugins/filebrowser/app/index.html');

// Bookmarkable deep link. The SPA lives in an iframe, so the URL the user sees
// and refreshes is *this* page's; the script below keeps `?path=` here in sync
// with wherever the SPA is browsing (postMessage -> history.replaceState), and
// on load we hand that path back to the SPA on the iframe URL.
//
// $_GET['path'] is attacker-supplied and is treated as pure data: it is never
// used to touch the filesystem, never logged, and only ever re-encoded into the
// iframe URL (rawurlencode below, then htmlspecialchars on the attribute). The
// checks here are transport hygiene - length and control characters - and the
// daemon still does the real path confinement, exactly as for any other path.
$fb_path = '';
if (isset($_GET['path']) && is_string($_GET['path'])) {
  $p = $_GET['path'];
  if ($p !== '' && strlen($p) <= 4096 && $p[0] === '/' && !preg_match('/[\x00-\x1F\x7F]/', $p)) {
    $fb_path = $p;
  }
}

$fb_src = $fb_app
        . '?theme=' . rawurlencode($fb_theme)
        . '&csrf='  . rawurlencode((string)$fb_csrf)
        . '&v='     . rawurlencode($fb_ver)
        . ($fb_path === '' ? '' : '&path=' . rawurlencode($fb_path));
?>
<style>
#fb-wrap        { margin:0; padding:0; }
#fb-frame       { width:100%; min-height:480px; border:0; display:block; background:transparent; }
#fb-offline     { margin:12px 0 18px 0; padding:14px 16px; border-left:4px solid #e0711a; background:rgba(128,128,128,.10); }
#fb-offline h3  { margin:0 0 6px 0; font-size:1.2rem; }
#fb-offline p   { margin:4px 0; }
#fb-offline .fb-actions { margin-top:12px; }
#fb-out         { margin-top:10px; white-space:pre-wrap; font-family:bitstream,monospace; font-size:1.1rem; display:none; }
</style>

<?PHP if (!$fb_running): ?>
<div id="fb-offline">
  <h3><i class="fa fa-warning"></i> <?=_('The File Browser daemon is not running')?></h3>
  <p><?=_('The web interface cannot load until filebrowserd is started.')?></p>
<?PHP if (!$fb_started): ?>
  <p><?=_('The array is not started. File Browser indexes data on the array, so start the array first.')?></p>
<?PHP endif; ?>
  <p><?=_('Autostart')?>:
     <strong><?=$fb_cfg['SERVICE'] == 'enable' ? _('Enabled') : _('Disabled')?></strong>
     &nbsp;&middot;&nbsp;
     <?=_('Data directory')?>: <strong><?=htmlspecialchars($fb_cfg['DATA_DIR'])?></strong>
  </p>
  <div class="fb-actions">
    <button type="button" id="fb-start"><i class="fa fa-play"></i> <?=_('Start')?></button>
    <a href="/Settings/FileBrowserSettings" class="fb-settings-link"><?=_('File Browser Settings')?></a>
  </div>
  <div id="fb-out"></div>
</div>
<?PHP else: ?>
<div id="fb-wrap">
  <iframe id="fb-frame" src="<?=htmlspecialchars($fb_src)?>" title="<?=htmlspecialchars(_('File Browser'))?>"
          allow="clipboard-write" referrerpolicy="same-origin"></iframe>
</div>
<?PHP endif; ?>

<script>
(function(){
  /* json_encode (not a bare interpolation) so nothing coming from the server
     can break out of this string literal into script context. */
  var csrf = <?=json_encode((string)$fb_csrf, JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT)?>;

  // ---- full-height iframe -------------------------------------------------
  // The four webGUI themes put the content area at different offsets (top-nav
  // vs sidebar), so measure rather than guess.
  var frame = document.getElementById('fb-frame');
  function fit() {
    if (!frame) return;
    var top = frame.getBoundingClientRect().top;
    var h   = window.innerHeight - top - 24;
    if (h < 480) h = 480;
    frame.style.height = h + 'px';
  }
  if (frame) {
    fit();
    window.addEventListener('resize', fit);
    // Theme/font switches and the sidebar toggle reflow the page after load.
    window.setTimeout(fit, 250);
    window.setTimeout(fit, 1000);
  }

  // ---- bookmarkable ?path= -----------------------------------------------
  // The SPA posts its current browse location up here whenever it settles; we
  // mirror it into our own address bar so refresh and bookmarks work. Nothing
  // is sent back down: the SPA got its starting path from the iframe URL above.
  //
  // replaceState, never pushState - the iframe keeps its own hash history, and
  // a parent entry per navigation would interleave with it and make Back jump
  // around. The path is data: it goes through encodeURIComponent into the query
  // string and is never written into HTML, an attribute, or script source.
  var lastPath = null;
  function fbSyncPath(p) {
    if (p === lastPath) return;
    lastPath = p;
    try {
      var u   = new URL(window.location.href);
      u.searchParams.delete('path');
      var rest = u.searchParams.toString();
      history.replaceState(history.state, '',
        u.pathname + '?path=' + encodeURIComponent(p) + (rest ? '&' + rest : '') + u.hash);
    } catch (e) { /* an address bar we may not rewrite is not worth breaking over */ }
  }
  window.addEventListener('message', function (ev) {
    // Two checks, both required: the message must come from our own origin, and
    // from our own iframe. Either alone lets a stranger (another frame on the
    // page, an opener, a cross-origin poster) drive this page's URL.
    if (!frame || ev.origin !== window.location.origin || ev.source !== frame.contentWindow) return;
    var d = ev.data;
    if (!d || typeof d !== 'object' || d.type !== 'filebrowser:location') return;
    var p = d.path;
    // Same transport hygiene as the PHP above, applied to the value we are
    // about to put in the URL: absolute, bounded, no control characters.
    if (typeof p !== 'string' || p === '' || p.length > 4096) return;
    if (p.charAt(0) !== '/' || /[\x00-\x1f\x7f]/.test(p)) return;
    fbSyncPath(p);
  });

  // ---- start button (offline banner) -------------------------------------
  var btn = document.getElementById('fb-start');
  var out = document.getElementById('fb-out');
  if (btn) {
    btn.addEventListener('click', function(){
      btn.disabled = true;
      out.style.display = 'block';
      out.textContent = <?=json_encode(_('Starting filebrowserd ...'), JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT)?>;
      $.post('/plugins/filebrowser/include/exec.php',
             {action:'start', csrf_token:csrf},
             function(data){
               if (data && data.ok && data.data && data.data.socket) {
                 location.reload();
                 return;
               }
               btn.disabled = false;
               var msg = (data && data.data && data.data.output) ? data.data.output
                       : ((data && data.error && data.error.message) ? data.error.message : <?=json_encode(_('Start failed'), JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT)?>);
               out.textContent = msg;
             }, 'json')
       .fail(function(){
               btn.disabled = false;
               out.textContent = <?=json_encode(_('Start failed - see /var/log/filebrowserd.log'), JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT)?>;
             });
    });
  }
})();
</script>
